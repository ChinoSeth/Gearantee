@model ASI.Basecode.Services.ServiceModels.EquipmentItem.EquipmentItemFormViewModel

<div class="mx-auto max-w-4xl">
    <a asp-action="Index" asp-route-tab="equipment" class="mb-5 inline-flex text-sm font-semibold text-primary-strong underline underline-offset-4">&larr; Back to equipment items</a>
    <section class="border border-gray-200 bg-white p-5 sm:p-8">
        <h2 class="font-display text-2xl font-semibold">Edit equipment item</h2>
        <p class="mt-1 text-sm text-gray-500">Update the inventory details, condition, and availability status.</p>

        @if (Model.IsLocked)
        {
            <div class="mt-5 border-l-4 border-ink bg-gray-50 px-4 py-3 text-sm" role="status">
                This item has a pending reservation or active loan. Close that transaction before changing its inventory details.
            </div>
        }
        else
        {
            <form asp-action="EditEquipment" method="post" class="mt-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EquipmentId" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
                @await Html.PartialAsync("_EquipmentItemFields", Model)
                <div class="mt-6 flex flex-wrap justify-end gap-3 border-t border-gray-100 pt-5">
                    <a asp-action="Index" asp-route-tab="equipment" class="border border-gray-200 px-4 py-2 text-sm">Cancel</a>
                    <button type="submit" class="btn-primary">Save changes</button>
                </div>
            </form>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
