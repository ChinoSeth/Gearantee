@model ASI.Basecode.Services.ServiceModels.Reservations.ReservationCreateViewModel
@using ASI.Basecode.Services.Utilities
@using ASI.Basecode.WebApp.Models.Dashboard
@{
    var item = Model.Item;
    var eligibilityError = ViewData["EligibilityError"] as string;
    var canSubmit = eligibilityError == null;
    var minLocal = ManilaClock.NowLocal.ToString("yyyy-MM-ddTHH:mm");
    var brandModel = string.Join(" ", new[] { item.Brand, item.Model }.Where(part => !string.IsNullOrWhiteSpace(part)));
}

<a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.EquipmentId" class="mb-6 inline-flex text-sm font-semibold text-primary-strong underline underline-offset-4">← Back to @item.ItemName</a>

@if (!canSubmit)
{
    <div class="mb-5 border-l-4 border-ink bg-white px-4 py-3 text-sm" role="alert">@eligibilityError</div>
}

<div class="grid items-start gap-8 xl:grid-cols-[minmax(0,1.1fr)_minmax(360px,0.9fr)]">
    <section aria-labelledby="request-heading" class="min-w-0 border border-gray-200 bg-white p-5 sm:p-8">
        <h2 id="request-heading" class="font-display text-2xl font-semibold text-ink">Reservation request</h2>
        <p class="mt-1 text-sm text-gray-500">Times are Philippine time. Your request stays pending until a custodian approves it.</p>

        <form asp-action="Create" method="post" class="mt-6">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <input type="hidden" asp-for="EquipmentId" />
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="ReservationStart" class="mb-1 block text-sm font-medium"></label>
                    <input asp-for="ReservationStart" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" min="@minLocal" class="input" />
                    <span asp-validation-for="ReservationStart" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="ReservationEnd" class="mb-1 block text-sm font-medium"></label>
                    <input asp-for="ReservationEnd" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" min="@minLocal" class="input" />
                    <span asp-validation-for="ReservationEnd" class="field-validation-error"></span>
                </div>
                <div class="sm:col-span-2">
                    <label asp-for="Purpose" class="mb-1 block text-sm font-medium"></label>
                    <textarea asp-for="Purpose" rows="4" maxlength="1000" class="input" placeholder="e.g. Thesis defense presentation in Room 301"></textarea>
                    <span asp-validation-for="Purpose" class="field-validation-error"></span>
                </div>
            </div>
            <div class="mt-6 flex flex-wrap justify-end gap-3">
                <a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.EquipmentId" class="border border-gray-200 px-4 py-2 text-sm">Cancel</a>
                <button type="submit" class="btn-primary" disabled="@(!canSubmit)">Submit request</button>
            </div>
        </form>
    </section>

    <aside aria-labelledby="item-heading" class="min-w-0 space-y-6">
        <div class="border border-gray-200 bg-white p-5">
            <p class="item-code">@item.ItemCode</p>
            <h2 id="item-heading" class="mt-1 font-display text-xl font-semibold text-ink">@item.ItemName</h2>
            <p class="mt-1 text-sm text-gray-500">@item.CategoryName@(string.IsNullOrEmpty(brandModel) ? "" : " · " + brandModel) · @item.Location</p>
        </div>

        <div>
            <div class="mb-3 flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 pb-3">
                <h3 class="font-display text-lg font-semibold text-ink">Booked times</h3>
                <p class="text-xs text-gray-500">Pick a time outside these</p>
            </div>
            @if (item.BookedWindows.Count == 0)
            {
                <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "No upcoming bookings", Message = "Any future time is open to request." })" />
            }
            else
            {
                <ul class="divide-y divide-gray-200 border border-gray-200 bg-white">
                    @foreach (var window in item.BookedWindows)
                    {
                        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
                            <span class="text-gray-700">@window.StartLocal.ToString("ddd d MMM · HH:mm") → @window.EndLocal.ToString("ddd d MMM · HH:mm")</span>
                            <partial name="Components/_StatusBadge" model="window.Label" />
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
