@using ASI.Basecode.Services.ServiceModels
@model BorrowerProfileListViewModel
@{
    ViewData["Title"] = "Borrower profiles";
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="mb-5 border-l-4 border-primary bg-white px-4 py-3 text-sm" role="status">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="mb-5 border-l-4 border-ink bg-white px-4 py-3 text-sm" role="alert">@errorMessage</div>
}

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
        <h2 class="font-display text-2xl font-semibold">Borrower profiles</h2>
        <p class="mt-1 text-xs text-gray-500">@Model.TotalCount record@(Model.TotalCount == 1 ? "" : "s") · eligibility controls who can submit reservation requests</p>
    </div>
</div>

<form method="get" asp-action="Index" class="mb-4 flex flex-wrap items-center gap-2">
    <div class="flex-1">
        <label class="sr-only" for="borrower-search">Search borrower profiles</label>
        <input id="borrower-search" name="search" value="@Model.Search" type="search" placeholder="Search school ID, name, or department" class="input w-full" />
    </div>
    <button type="submit" class="btn-primary">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a asp-action="Index" class="border border-gray-200 bg-white px-4 py-2 text-sm text-gray-700">Clear</a>
    }
</form>

<div class="overflow-x-auto border border-gray-200 bg-white">
    <table class="w-full min-w-[620px] text-left text-sm">
        <thead class="border-b border-gray-200 bg-gray-50 font-display text-[11px] uppercase tracking-[0.12em] text-gray-700">
            <tr>
                <th scope="col" class="px-3 py-3">School ID</th>
                <th scope="col" class="px-3 py-3">Name</th>
                <th scope="col" class="px-3 py-3">Department</th>
                <th scope="col" class="px-3 py-3">Contact number</th>
                <th scope="col" class="px-3 py-3">Eligibility</th>
                <th scope="col" class="px-3 py-3"><span class="sr-only">Actions</span></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            @if (Model.Borrowers.Count == 0)
            {
                <tr><td colspan="6" class="px-4 py-12 text-center text-sm text-gray-500">@(string.IsNullOrWhiteSpace(Model.Search) ? "No borrower profiles yet." : "No borrower profiles match that search.")</td></tr>
            }
            @foreach (var borrower in Model.Borrowers)
            {
                <tr class="align-middle">
                    <td class="px-3 py-3 item-code">@borrower.SchoolId</td>
                    <td class="px-3 py-3 font-semibold text-ink">@borrower.BorrowerName</td>
                    <td class="px-3 py-3 text-gray-700">@borrower.Department</td>
                    <td class="px-3 py-3 text-gray-700">@borrower.ContactNumber</td>
                    <td class="px-3 py-3">
                        <span class="inline-flex border px-2 py-1 text-[11px] @(borrower.IsEligible ? "border-primary text-primary-strong" : "border-gray-200 text-gray-500")">@(borrower.IsEligible ? "Eligible" : "Not eligible")</span>
                    </td>
                    <td class="px-3 py-3 text-right">
                        <div class="flex items-center justify-end gap-3">
                            <a asp-action="Edit" asp-route-id="@borrower.BorrowerProfileId" class="text-xs font-semibold text-primary-strong underline underline-offset-4">Edit</a>
                            <form asp-action="UpdateEligibility" method="post" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@borrower.BorrowerProfileId" />
                                <input type="hidden" name="isEligible" value="@(!borrower.IsEligible ? "true" : "false")" />
                                <button type="submit" class="text-xs font-semibold text-primary-strong underline underline-offset-4">@(borrower.IsEligible ? "Mark ineligible" : "Mark eligible")</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-gray-700">
        <span>Page @Model.Page of @Model.TotalPages</span>
        <div class="flex gap-2">
            @if (Model.Page > 1)
            {
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page - 1)" class="border border-gray-200 bg-white px-3 py-2 text-gray-700">Previous</a>
            }
            @if (Model.Page < Model.TotalPages)
            {
                <a asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" class="border border-gray-200 bg-white px-3 py-2 text-gray-700">Next</a>
            }
        </div>
    </div>
}
