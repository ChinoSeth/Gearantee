@using ASI.Basecode.Services.ServiceModels
@model BorrowerProfileUpdateViewModel
@{
    ViewData["Title"] = "Edit borrower profile";
    var borrowerProfileId = ViewData["BorrowerProfileId"];
    var schoolId = ViewData["SchoolId"] as string;
    var borrowerName = ViewData["BorrowerName"] as string;
    var isEligible = ViewData["IsEligible"] as bool? ?? false;
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

<div class="mx-auto max-w-4xl">
    <a asp-action="Index" class="mb-5 inline-flex text-sm font-semibold text-primary-strong underline underline-offset-4">← Back to borrower profiles</a>
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="mb-5 border-l-4 border-primary bg-white px-4 py-3 text-sm" role="status">@successMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="mb-5 border-l-4 border-ink bg-white px-4 py-3 text-sm" role="alert">@errorMessage</div>
    }

    <section class="border border-gray-200 bg-white p-5 sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <p class="item-code">@schoolId</p>
                <h2 class="mt-1 font-display text-2xl font-semibold">@borrowerName</h2>
                <p class="mt-1 text-sm text-gray-500">School ID: <span class="font-semibold text-gray-700">@schoolId</span></p>
            </div>
            <span class="inline-flex border px-2 py-1 text-xs @(isEligible ? "border-primary text-primary-strong" : "border-gray-200 text-gray-500")">@(isEligible ? "Eligible" : "Not eligible")</span>
        </div>

        <form asp-action="Edit" method="post" class="mt-6">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <input type="hidden" name="id" value="@borrowerProfileId" />
            <input type="hidden" name="ConcurrencyStamp" value="@Model.ConcurrencyStamp" />
            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="Department" class="mb-1 block text-sm font-medium"></label>
                    <input asp-for="Department" class="input" />
                    <span asp-validation-for="Department" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="ContactNumber" class="mb-1 block text-sm font-medium"></label>
                    <input asp-for="ContactNumber" class="input" />
                    <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                </div>
            </div>
            <p class="mt-3 text-xs text-gray-500">School ID and eligibility are not editable here. Eligibility is managed from the borrower profiles list.</p>
            <div class="mt-6 flex flex-wrap justify-end gap-3 border-t border-gray-200 pt-5">
                <a asp-action="Index" class="border border-gray-200 px-4 py-2 text-sm">Cancel</a>
                <button type="submit" class="btn-primary">Save changes</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}