@model ASI.Basecode.Services.ServiceModels.Catalog.CatalogItemDetailsViewModel
@using ASI.Basecode.WebApp.Models.Dashboard
@{
    string OrDash(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    var statusLabel = Model.AvailabilityStatus == DomainValues.EquipmentStatuses.Borrowed ? "Borrowed" : "Available";
    var fromValue = (ViewData["From"] as DateTime?)?.ToString("yyyy-MM-ddTHH:mm");
    var toValue = (ViewData["To"] as DateTime?)?.ToString("yyyy-MM-ddTHH:mm");
    var canReserve = User.IsInRole(DomainValues.Roles.Borrower) && User.HasClaim("permission", DomainValues.Permissions.ReservationCreate);
}


<a asp-action="Index" class="mb-6 inline-flex text-sm font-semibold text-primary-strong underline underline-offset-4">← Back to catalog</a>

<div class="grid items-start gap-8 xl:grid-cols-[minmax(0,1.1fr)_minmax(360px,0.9fr)]">
    <section aria-labelledby="item-heading" class="min-w-0 border border-gray-200 bg-white">
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.ItemName" class="aspect-[16/7] w-full bg-white object-contain" />
        }
        else
        {
            <div class="flex aspect-[16/7] w-full items-center justify-center bg-primary text-white" aria-label="No equipment image available">
                @await Html.PartialAsync("../Shared/Icons/_Icon", "equipment")
            </div>
        }
        <div class="p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                    <p class="item-code">@Model.ItemCode</p>
                    <h2 id="item-heading" class="mt-1 font-display text-2xl font-semibold text-ink">@Model.ItemName</h2>
                </div>
                <partial name="Components/_StatusBadge" model="statusLabel" />
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mt-4 text-sm leading-6 text-gray-700">@Model.Description</p>
            }
            <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2">
                <div><dt class="text-xs text-gray-500">Category</dt><dd class="mt-1 font-medium text-gray-700">@Model.CategoryName</dd></div>
                <div><dt class="text-xs text-gray-500">Condition</dt><dd class="mt-1 font-medium text-gray-700">@Model.ConditionStatus</dd></div>
                <div><dt class="text-xs text-gray-500">Brand</dt><dd class="mt-1 font-medium text-gray-700">@OrDash(Model.Brand)</dd></div>
                <div><dt class="text-xs text-gray-500">Model</dt><dd class="mt-1 font-medium text-gray-700">@OrDash(Model.Model)</dd></div>
                <div><dt class="text-xs text-gray-500">Serial number</dt><dd class="mt-1 font-medium text-gray-700">@OrDash(Model.SerialNumber)</dd></div>
                <div><dt class="text-xs text-gray-500">Location</dt><dd class="mt-1 font-medium text-gray-700">@Model.Location</dd></div>
            </dl>
            <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-gray-200 pt-5">
                @if (canReserve)
                {
                    <a asp-controller="Reservation" asp-action="Create" asp-route-equipmentId="@Model.EquipmentId" asp-route-from="@fromValue" asp-route-to="@toValue" class="btn-primary">Reserve this item</a>
                }
            </div>
        </div>
    </section>

    <section aria-labelledby="schedule-heading" class="min-w-0">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 pb-3">
            <h2 id="schedule-heading" class="font-display text-xl font-semibold text-ink">Booked times</h2>
            <p class="text-xs text-gray-500">Philippine time · pick a time outside these</p>
        </div>
        @if (Model.BookedWindows.Count == 0)
        {
            <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "No upcoming bookings", Message = "This item has no approved reservations or active loans. Any future time is open to request." })" />
        }
        else
        {
            <ul class="divide-y divide-gray-200 border border-gray-200 bg-white">
                @foreach (var window in Model.BookedWindows)
                {
                    <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
                        <span class="text-gray-700">@window.StartLocal.ToString("ddd d MMM · HH:mm") → @window.EndLocal.ToString("ddd d MMM · HH:mm")</span>
                        <partial name="Components/_StatusBadge" model="window.Label" />
                    </li>
                }
            </ul>
            <p class="mt-3 text-xs leading-5 text-gray-500">Pending requests from other borrowers are not shown here. The custodian checks for conflicts again before approving.</p>
        }
    </section>
</div>
