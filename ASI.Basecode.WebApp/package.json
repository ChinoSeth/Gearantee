{
  "name": "gearantee-webapp",
  "private": true,
  "scripts": {
    "css:dev": "tailwindcss -i ./wwwroot/css/tailwind.src.css -o ./wwwroot/css/app.css --watch",
    "css:build": "tailwindcss -i ./wwwroot/css/tailwind.src.css -o ./wwwroot/css/app.css --minify",
    "vendor:build": "node ./scripts/copy-calendar-assets.mjs",
    "assets:build": "npm run vendor:build && npm run css:build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "fullcalendar": "7.1.2"
  }
}
